# Copy to .env (git-ignored). Used by docker-compose.yml and the backend db tooling.

# PostgreSQL container
POSTGRES_USER=formbuilder
POSTGRES_PASSWORD=formbuilder
POSTGRES_DB=formbuilder
# Host port. 55432 by default so it never collides with a PostgreSQL already
# installed on the machine (which usually owns 5432).
POSTGRES_PORT=55432
# ADMINER_PORT=8080

# Backend API and db tooling (python -m db.migrate, python -m db.import_json, pytest).
# Must match the values above.
DATABASE_URL=postgresql://formbuilder:formbuilder@localhost:55432/formbuilder

# Seconds a request waits for a database connection before answering 503
# FORMBUILDER_DB_TIMEOUT=5
